# ── doc-harbor: inställningar ────────────────────────────────────────────────
# Kopiera till .env och ändra. Raderna utan värde är valfria.

# Krävs. Hemlig nyckel för inloggningskakor. Skapa en med:  openssl rand -hex 32
# Utan den loggas alla ut varje gång servern startar om.
SECRET_KEY=

# Valfritt och normalt tomt: välj admin-lösenordet på /setup första gången.
# OBS: är det satt skrivs admin-lösenordet över med detta värde varje gång en ny
# version av imagen startas. Använd det bara om du har låst ute dig.
ADMIN_PASSWORD=

# Låt vem som helst skapa ett konto via e-post (/register). Av som standard –
# admin skapar annars kontona under Användare.
REGISTRATION_ENABLED=false

# E-post (behövs för registrering och gruppinbjudningar).
SMTP_HOST=localhost
SMTP_PORT=25
FROM_EMAIL=noreply@localhost

# Anonym uppdateringskoll: en gång per dygn frågar servern om det finns en ny
# version och visar det för admin. Skickar bara ett slumpat instans-ID och
# versionsnumret – inget om användare eller filer. Sätt till false för att stänga av.
UPDATE_CHECK=true
